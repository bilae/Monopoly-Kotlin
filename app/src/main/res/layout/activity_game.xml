<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <!-- Plateau Monopoly -->
    <ImageView
        android:id="@+id/boardImage"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:src="@drawable/plateau_monopoly"
        android:layout_centerInParent="true"/>

    <!-- Bots autour du plateau -->
    <TextView
        android:id="@+id/bot1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bot 1"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/primaryColor"
        android:layout_above="@id/boardImage"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/Joueur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Joueur"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/primaryColor"
        android:layout_below="@id/boardImage"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/bot3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bot 2"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/primaryColor"
        android:layout_toStartOf="@id/boardImage"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp"/>

    <TextView
        android:id="@+id/bot4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bot 3"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/primaryColor"
        android:layout_toEndOf="@id/boardImage"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"/>

    <Button
        android:id="@+id/myButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Lancer le dé"
        android:layout_below="@id/Joueur"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"/>



</RelativeLayout>
